{
  "entry": [
    "server.js",
    "public/**/*.js",
    "scripts/**/*.js",
    "src/**/*.js",
    "data/scenarios/**/*.js"
  ],
  "ignorePatterns": [
    "public/vendor/**",
    "public/css/**",
    "scratch/**"
  ],
  "ignoreDependencies": [
    "@yaireo/tagify"
  ],
  "ignoreUnresolvedImports": [
    "/socket.io/socket.io.js"
  ]
}
